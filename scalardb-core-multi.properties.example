# ScalarDB Core (Consensus Commit) on multi-storage: ordering -> Oracle; customer, inventory
# and the coordinator table -> PostgreSQL. Copy to scalardb-core-multi.properties and set your
# values (not in git). Run with --spring.profiles.active=core-multi. The tables are created by
# the Schema Loader with this file and --coordinator.
scalar.db.transaction_manager=consensus-commit
scalar.db.storage=multi-storage
scalar.db.multi_storage.storages=postgresql,oracle
scalar.db.multi_storage.storages.postgresql.storage=jdbc
scalar.db.multi_storage.storages.postgresql.contact_points=jdbc:postgresql://<host>:5432/<database>
scalar.db.multi_storage.storages.postgresql.username=<password>
scalar.db.multi_storage.storages.postgresql.password=<password>
scalar.db.multi_storage.storages.oracle.storage=jdbc
scalar.db.multi_storage.storages.oracle.contact_points=jdbc:oracle:thin:@//<host>:1521/<service>
scalar.db.multi_storage.storages.oracle.username=<user>
scalar.db.multi_storage.storages.oracle.password=<password>
scalar.db.multi_storage.namespace_mapping=customer:postgresql,inventory:postgresql,ordering:oracle,coordinator:postgresql
scalar.db.multi_storage.default_storage=postgresql
scalar.db.consensus_commit.isolation_level=READ_COMMITTED
# Needed by GET /customers/{id}/orders?method=scan (ScanAll + where)
scalar.db.cross_partition_scan.enabled=true
scalar.db.cross_partition_scan.filtering.enabled=true
